cat /etc/os-release
sudo apt update
sudo apt install -y curl wget git apt-transport-https ca-certificates gnupg

# Remove conflicting Docker packages
# If this is a fresh machine, many of these may not exist. That's fine.
sudo apt remove -y docker.io docker-compose docker-compose-v2 docker-doc docker-buildx podman-docker containerd runc
sudo apt update

# Install prerequisites:
sudo apt install -y ca-certificates curl

# Create keyring:
sudo install -m 0755 -d /etc/apt/keyrings

# Download Docker GPG key:
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
-o /etc/apt/keyrings/docker.asc

# Set permission:
sudo chmod a+r /etc/apt/keyrings/docker.asc

# Now add repository:
sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

# Update:
sudo apt update

# Install Docker

# Run:
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Installation can take a few minutes.

# Check:
docker --version

# Check service:
sudo systemctl status docker

# Enable Docker at boot
# Run:
sudo systemctl enable docker
sudo systemctl enable containerd

# Docker normally starts automatically on Ubuntu after installation

# Test Docker
sudo docker run hello-world

# Allow your user to use Docker without sudo
# We don't want to use sudo every time.

# Run:
sudo usermod -aG docker $USER

# Then:
newgrp docker

