# Install kubectl
# Now we need Kubernetes CLI.
# Architecture:
# kubectl
   │
   │ Kubernetes API
   ▼
# Kubernetes API Server

## Official binary installation

# For x86-64:
curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"

# Make it executable/install it:
sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

# Check:
kubectl version --client

# Example:
# Client Version: v1.3x.x
# Kustomize Version: v5.x.x

# Verify kubectl location
which kubectl

# Expected: /usr/local/bin/kubectl

# Check:
kubectl version --client --output=yaml

## At this point:

# Ubuntu
   │
   ├── Docker ✅
   │
   └── kubectl ✅

# But Kubernetes itself isn't running yet.

# Install Minikube

# Now the main component. Official Minikube provides a stable Linux AMD64 binary installation command.

# For x86-64:
curl -LO https://github.com/kubernetes/minikube/releases/latest/download/minikube-linux-amd64

# Install:
sudo install minikube-linux-amd64 /usr/local/bin/minikube

# Remove downloaded binary:
rm minikube-linux-amd64

# Verify:
minikube version

# Configure Docker as Minikube driver

# Run:
minikube config set driver docker

# Expected: These changes will take effect upon a minikube delete and then a minikube start

# Verify:
minikube config get driver

# Minikube specifically supports:
minikube start --driver=docker

# and Docker can be made the default driver using minikube config set driver docker

# Start Kubernetes cluster

# Now the exciting part.

# Run:
minikube start --driver=docker

