#STEP 0 — Check Your Kubernetes Cluster
kubectl version
kubectl get nodes

#Make sure your nodes are Ready:
kubectl get nodes

#Expected:

#NAME      STATUS   ROLES           AGE
#master    Ready    control-plane   ...
#worker1   Ready    <none>          ...
#STEP 1 — Install Gateway API CRDs

#You can directly install the Standard Gateway API CRDs:

kubectl apply --server-side \
  -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.6.1/standard-install.yaml

#The Standard channel includes stable and beta Gateway API resources such as GatewayClass, Gateway, HTTPRoute, and ReferenceGrant.

#Verify:

kubectl get crd | grep gateway.networking.k8s.io

# You should see resources similar to:

# gatewayclasses.gateway.networking.k8s.io
# gateways.gateway.networking.k8s.io
# httproutes.gateway.networking.k8s.io
# referencegrants.gateway.networking.k8s.io

# Check API resources:

kubectl api-resources | grep gateway

# STEP 2 — Install Envoy Gateway

# For a hands-on lab, Helm is the recommended installation approach because it gives better configuration control than manually applying an old static manifest.

# If Helm is not installed:

helm version

# Install Envoy Gateway:

helm install eg \
  oci://docker.io/envoyproxy/gateway-helm \
  --version v1.9.0 \
  -n envoy-gateway-system \
  --create-namespace

# Wait for the controller:

kubectl wait \
  --timeout=5m \
  -n envoy-gateway-system \
  deployment/envoy-gateway \
  --for=condition=Available

# Verify:

kubectl get pods -n envoy-gateway-system

# Expected:

# NAME                             READY   STATUS    RESTARTS
# envoy-gateway-xxxxxxxxxx-xxxxx   1/1     Running   0

# The official Envoy Gateway examples use this installation model and a GatewayClass managed by the Envoy Gateway controller.

# STEP 3 — Create GatewayClass

# Create the file:

vi 01-gatewayclass.yaml

# Paste:

apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: eg-demo
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller

# Apply:

kubectl apply -f 01-gatewayclass.yaml

# Verify:

kubectl get gatewayclass

# Expected:

# NAME      CONTROLLER
# eg-demo   gateway.envoyproxy.io/gatewayclass-controller

# Check detailed status:

kubectl describe gatewayclass eg-demo

# You want:

# Accepted=True
# STEP 4 — Create Demo Namespace

vi 02-namespace.yaml
apiVersion: v1
kind: Namespace
metadata:
  name: gateway-demo

# Apply:

kubectl apply -f 02-namespace.yaml

# Verify:

kubectl get ns gateway-demo

#STEP 5 — Create Web Application

# First create the ConfigMap.

# This fixes one of the problems in your original deployment order.

vi 03-web-configmap.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: web-html
  namespace: gateway-demo
data:
  index.html: |
    <!DOCTYPE html>
    <html>
    <head>
      <title>Gateway API Web</title>
    </head>

    <body>
      <h1>Gateway API Host Routing Works!</h1>
      <h2>Application: WEB</h2>

      <p id="host"></p>
      <p id="path"></p>

      <script>
        document.getElementById("host").innerHTML =
          "Host: " + window.location.host;

        document.getElementById("path").innerHTML =
          "Path: " + window.location.pathname;
      </script>
    </body>
    </html>

# Apply:

kubectl apply -f 03-web-configmap.yaml

#STEP 6 — Create Web Deployment

vi 04-web-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: gateway-demo

spec:
  replicas: 2

  selector:
    matchLabels:
      app: web

  template:
    metadata:
      labels:
        app: web

    spec:
      containers:
        - name: nginx
          image: nginx:stable-alpine

          ports:
            - containerPort: 80

          volumeMounts:
            - name: html
              mountPath: /usr/share/nginx/html

          resources:
            requests:
              cpu: 100m
              memory: 64Mi

      volumes:
        - name: html
          configMap:
            name: web-html

#Apply:

kubectl apply -f 04-web-deployment.yaml

#Wait:

kubectl rollout status deployment/web -n gateway-demo

@Check:

kubectl get pods -n gateway-demo

#STEP 7 — Create Web Service

vi 05-web-service.yaml
apiVersion: v1
kind: Service
metadata:
  name: web-service
  namespace: gateway-demo

spec:
  selector:
    app: web

  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: 80

#Apply:

kubectl apply -f 05-web-service.yaml

#Verify:

kubectl get svc -n gateway-demo

#Test from inside the cluster:

kubectl run curl-test \
  --rm \
  -it \
  --image=curlimages/curl \
  -n gateway-demo \
  -- \
  curl web-service

# You should receive:

# Gateway API Host Routing Works!

