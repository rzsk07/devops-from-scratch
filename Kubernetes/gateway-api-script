# STEP 15 — Find the Envoy Service

# Envoy Gateway creates Envoy infrastructure for your Gateway. The official documentation demonstrates discovering the generated Envoy Service using labels rather than assuming a fixed service name.

# Run:

kubectl get svc -n envoy-gateway-system \
  -l gateway.envoyproxy.io/owning-gateway-namespace=gateway-demo,\
gateway.envoyproxy.io/owning-gateway-name=eg-demo-gateway

# Store the service name:

export ENVOY_SERVICE=$(kubectl get svc \
  -n envoy-gateway-system \
  -l gateway.envoyproxy.io/owning-gateway-namespace=gateway-demo,\
gateway.envoyproxy.io/owning-gateway-name=eg-demo-gateway \
  -o jsonpath='{.items[0].metadata.name}')

# Check:

echo $ENVOY_SERVICE

Example:

envoy-default-eg-demo-gateway-xxxxx

#STEP 16 — Port Forward the Gateway

# For the first hands-on lab, port forwarding is simpler and more reliable than assuming NodePort or cloud LoadBalancer configuration.

kubectl port-forward \
  -n envoy-gateway-system \
  service/$ENVOY_SERVICE \
  8080:80

# Keep this terminal open.

# You should see:

Forwarding from 127.0.0.1:8080 -> 80

