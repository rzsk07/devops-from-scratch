kubectl apply -f 07-api-deployment.yaml

Wait:

kubectl rollout status deployment/api -n gateway-demo

#STEP 10 — Create API Service

vi 08-api-service.yaml
apiVersion: v1
kind: Service
metadata:
  name: api-service
  namespace: gateway-demo

spec:
  selector:
    app: api

  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: 80

Apply:

kubectl apply -f 08-api-service.yaml

Verify:

kubectl get svc -n gateway-demo

#STEP 11 — Create Gateway

#This is the entry point into our cluster applications.

vi 09-gateway.yaml

apiVersion: gateway.networking.k8s.io/v1
kind: Gateway

metadata:
  name: eg-demo-gateway
  namespace: gateway-demo

spec:
  gatewayClassName: eg-demo

  listeners:
    - name: http
      protocol: HTTP
      port: 80

      allowedRoutes:
        namespaces:
          from: Same

#Apply:

kubectl apply -f 09-gateway.yaml

#Check:

kubectl get gateway -n gateway-demo

#Detailed status:

kubectl describe gateway eg-demo-gateway -n gateway-demo

#You want to eventually see:

Programmed=True

#Check the listener:

kubectl get gateway eg-demo-gateway \
  -n gateway-demo \
  -o yaml

#STEP 12 — Create Host-Based HTTPRoute

Now:

Host: web.gateway.local
        |
        v
   web-service

Create:

vi 10-web-route.yaml
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: web-route
  namespace: gateway-demo

spec:

  parentRefs:
    - name: eg-demo-gateway

  hostnames:
    - "web.gateway.local"

  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /

      backendRefs:
        - name: web-service
          port: 80

#Apply:

kubectl apply -f 10-web-route.yaml

#Verify:

kubectl get httproute -n gateway-demo

#Detailed:

kubectl describe httproute web-route -n gateway-demo

#Look for:

Accepted=True
ResolvedRefs=True

#STEP 13 — Create Path-Based HTTPRoute

# Now we will use:

Host: api.gateway.local

Routing:

/          → web-service

/api       → api-service

/health    → api-service

#Create:

vi 11-api-route.yaml

apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: api-route
  namespace: gateway-demo

spec:

  parentRefs:
    - name: eg-demo-gateway

  hostnames:
    - "api.gateway.local"

  rules:

    - matches:
        - path:
            type: PathPrefix
            value: /api

      backendRefs:
        - name: api-service
          port: 80


    - matches:
        - path:
            type: PathPrefix
            value: /health

      backendRefs:
        - name: api-service
          port: 80


    - matches:
        - path:
            type: PathPrefix
            value: /

      backendRefs:
        - name: web-service
          port: 80

#Apply:

kubectl apply -f 11-api-route.yaml

#Verify:

kubectl get httproute -n gateway-demo

#STEP 14 — Verify All Resources
kubectl get all -n gateway-demo
kubectl get gateway -n gateway-demo
kubectl get httproute -n gateway-demo

#Expected structure:

# Gateway
